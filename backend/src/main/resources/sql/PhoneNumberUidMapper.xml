<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tutoring_software.backend.uid_management.mapper.PhoneNumberUidMapper">

    <select id="selectByPhoneNumber" resultType="com.tutoring_software.backend.uid_management.entity.PhoneNumberUid">
        SELECT * FROM phone_number_id WHERE phone_number = #{phoneNumber}
    </select>

    <select id="selectByUid" resultType="com.tutoring_software.backend.uid_management.entity.PhoneNumberUid">
        SELECT * FROM phone_number_id WHERE uid = #{uid}
    </select>
</mapper>
